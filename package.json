{
  "name": "simple-voice-changer",
  "version": "2.3.2",
  "private": false,
  "scripts": {
    "dev": "npm run copy-worklets-worklets && next dev --webpack",
    "build": "next build --webpack",
    "start": "next start --webpack",
    "lint": "next lint",
    "test": "npx playwright test",
    "prebuild": "npm run copy-worklets-worklets",
    "copy-worklets-worklets": "mkdir -p public/worklets public/workers && cp node_modules/@eliastik/simple-sound-studio-lib/dist/worklets/*.js public/worklets/ && cp node_modules/@eliastik/simple-sound-studio-lib/dist/workers/*.js public/workers/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eliastik/simple-voice-changer.git"
  },
  "dependencies": {
    "@eliastik/simple-sound-studio-components": "^2.3.2",
    "@eliastik/simple-sound-studio-lib": "^2.3.2",
    "i18next": "^26.3.6",
    "lodash": "^4.18.1",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "semver": "^7.8.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/audioworklet": "^0.0.75",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.66.1",
    "@typescript-eslint/parser": "^8.67.0",
    "autoprefixer": "^10.5.4",
    "daisyui": "^5.7.17",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "eslint-plugin-react": "^7.37.5",
    "glob": "^13.0.6",
    "next-pwa": "^5.6.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "serialize-javascript": "7.1.0"
  }
}
